#!/bin/bash
# Claude Code를 열 때(SessionStart 훅) 내 맥에서 고칠 게 있으면 화면에 한 줄 알려 준다. Claude에게는 넘기지 않음.
# 6시간에 한 번만 확인(여는 속도 영향 없게), 아무것도 바꾸지 않음. 자세한 점검은 nuua-check.
ST="$HOME/.claude/.nuua-hint"
[ -f "$ST" ] && [ $(($(date +%s) - $(stat -f %m "$ST"))) -lt 21600 ] && exit 0
touch "$ST"
msg=""
add() { msg="${msg:+$msg · }$1"; }
mine=$(sed -n 's/^KIT_VER=\([0-9.]*\).*/\1/p' "$HOME/claude-setup-kit/install.sh" 2>/dev/null)
new=$(curl -fsSL --max-time 3 https://raw.githubusercontent.com/zkxks1004-eng/claude-setup-kit/main/install.sh 2>/dev/null | sed -n 's/^KIT_VER=\([0-9.]*\).*/\1/p')
[ -n "$mine" ] && [ -n "$new" ] && [ "$mine" != "$new" ] && [ "$(printf '%s\n%s\n' "$mine" "$new" | sort -V | head -1)" = "$mine" ] && add "설치 키트 새 판($new)이 나왔어요 → 설치 사이트 1단계 명령으로 다시 설치"
PATH="$HOME/.local/bin:$HOME/.local/node/bin:$PATH" command -v npx >/dev/null || add "Node가 없어 브라우저 등 일부 연결 도구가 안 돼요 → 설치를 다시 실행"
[ -n "$msg" ] && printf '{"systemMessage":"누아 안내: %s (자세히: 터미널에 nuua-check)"}\n' "$msg"
exit 0
